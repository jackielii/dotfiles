[user]
     email = jackie.space@gmail.com
     name = Jackie Li
     signingkey = 9D44BB781C299FEF

[alias]
    st = status
    ci = commit
    br = branch
    co = checkout
    df = diff
    ds = diff --staged
    lg = log -p
    lol = log --graph --decorate --pretty=oneline --abbrev-commit
    lola = log --graph --decorate --pretty=oneline --abbrev-commit --all --date=local
    ls = ls-files
    unstage = reset HEAD
    undo = reset --soft HEAD~1

    # Show files ignored by git:
    ign = ls-files -o -i --exclude-standard

[core]
    whitespace=fix,-indent-with-non-tab,trailing-space,cr-at-eol
    excludesfile = ~/.gitignore_global

[credential "https://gitlab.com"]
    tesgo = jackieli

[credential]
    helper = store

; [http ]
;   proxy = socks5://localhost:7777
; [https ]
;   proxy = socks5://localhost:7777

[url "ssh://git@gitlab.com/"]
        insteadOf = https://gitlab.com/

[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f

[url "git@github.com:"]
	insteadof = https://github.com

;[sendemail]
;        smtpserver = smtp.gmail.com
;        smtpuser = jackie.space@gmail.com
;        smtpencryption = tls
;        smtpserverport = 587

[merge]
	conflictstyle = diff3

[init]
	defaultBranch = main
[commit]
	gpgSign = true
[push]
	followTags = true
	autoSetupRemote = true
[difftool "kitty"]
    ; cmd = /Users/jackieli/personal/kitty/kitty/launcher/kitten diff $LOCAL $REMOTE
    cmd = kitten diff $LOCAL $REMOTE
[difftool "kitty.gui"]
    cmd = kitten diff $LOCAL $REMOTE
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[difftool]
	prompt = false
[includeIf "gitdir:~/work/"]
	path = ~/work/.gitconfig-ssh
# work repos outside ~/work (e.g. go's module cache) still get the work ssh identity
[includeIf "hasconfig:remote.*.url:https://github.com/tespkg/**"]
	path = ~/work/.gitconfig-ssh
[includeIf "hasconfig:remote.*.url:git@github.com:tespkg/**"]
	path = ~/work/.gitconfig-ssh
[includeIf "hasconfig:remote.*.url:https://gitlab.com/target-digital-transformation/**"]
	path = ~/work/.gitconfig-ssh
[includeIf "hasconfig:remote.*.url:git@gitlab.com:target-digital-transformation/**"]
	path = ~/work/.gitconfig-ssh
